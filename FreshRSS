:root {
    --thumbnail-height: 8.5rem;
    --thumbnail-height-mobile: 6rem;
    --font-size-mobile: 0.9rem;
    --title-font-size: 1.1rem;
}

/*3 buttons in opend article*/
footer .item.manage, footer .item.link {
    margin-top: -3px !important;
}

/*AI summary*/
.oai-summary-wrap {
    padding: unset !important;
    background: unset !important;
}
.oai-summary-content {
    color: white !important;
}

@media screen and (min-width: 841px) {
    /*font size*/
    .item-element.title {
        font-size: var(--title-font-size) !important;
        padding-top: 35px !important;
        padding-bottom: 5px !important;
    }

    /*move (un)read / favi button to right*/
    .item.manage {
        order: 1 !important;
    }

    /*thumbnail*/
    .item.thumbnail {
        width: calc(var(--thumbnail-height)/9*16) !important;
        height: var(--thumbnail-height) !important;
    }

    /*website*/
    .item.website {
        position: absolute;
        /*left: calc(var(--thumbnail-width) + 15rem);*/
        left: calc(var(--thumbnail-height)/9*16 + 12px);
        top: 0px;
        width: calc(100vw - var(--thumbnail-height)/9*16 - 350px) !important;
    }

    /*3 buttons */
    .item.manage, .item.link {
        margin-top: calc(var(--thumbnail-height)*-0.5 - 52px) !important;;
    }

    /*summary*/
    .summary {
        height: calc(var(--thumbnail-height) - var(--title-font-size) - 35px) !important;
        width: calc(100vw - 340px - var(--thumbnail-height)/9*16) !important;
    }
    .item.titleAuthorSummaryDate {
        overflow: visible !important;
    }
}

@media screen and (max-width: 840px) {
    /*font size*/
    .item-element.title {
        font-size: var(--title-font-size) !important;
        padding-top: 5px !important;
        padding-bottom: 5px !important;
    }

    /*summary/content*/
    .summary {
        height: calc(var(--thumbnail-height-mobile) - var(--title-font-size) - 35px) !important;
    }

    /*topbar area in article*/
    .item.manage a, .item.website a, .item.link a {
        padding-top: 0px !important;
        padding-bottom: 0px !important;
    }

    /*website*/
    .item.website {
        margin-left: calc(var(--thumbnail-height-mobile)/9*16 + 0.5rem) !important;
        width: 100px !important;
    }

    /*thumbnail*/
    .item.thumbnail {
        margin-top: calc(-35px + 0.5rem);
        width: calc(var(--thumbnail-height-mobile)/9*16) !important;
        height: var(--thumbnail-height-mobile) !important;
    }

    /*pubdate*/
    .item.titleAuthorSummaryDate {
        display: flex !important;
        flex-direction: column !important;
        overflow: visible !important;
    }
    .item-element.date {
        order: 1 !important;
        display: block;
        margin-top: -32px;
        margin-right: 102px;
        height: 25.5px;
        padding-bottom: 0px !important;
    }
    .item-element.title {
        order: 2 !important;
    }
    .summary {
        order: 3 !important;
    }
}

@media screen and (max-width: 540px) {
    /*title*/
    .item-element.title {
        font-size: var(--font-size-mobile) !important;
        padding-top: 0px !important;
        padding-bottom: 0px !important;
    }
    
    /*summary/content*/
    .summary {
        font-size: var(--font-size-mobile) !important;
        height: calc(var(--font-size-mobile)*4.6) !important;
        margin-bottom: 0px !important;
    }
    
    /*thumbnail*/
    .item.thumbnail {
        margin-top: 0px;
        width: 80px !important;
        height: 80px !important;
    }
    
    /*website*/
    .item.website {
        margin-left: 0px !important;
        width: calc(100vw - 270px) !important;
    }
    
    /*adjust margin-top on mobile*/
    .item.manage, .item.link {
        margin-top: -2px !important;
    }
}
